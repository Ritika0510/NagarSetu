# NagarSetu Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env
# NEVER commit .env to version control.

# --- LLM Provider API Keys ---
# Provide at least one API key for live generation.
# If omitted or empty, the application automatically enters Demo Mode.
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Application Runtime Flags ---
DEMO_MODE=true
LANGUAGE_DEFAULT=en
LOG_LEVEL=INFO
ENVIRONMENT=development
# Set to 'true' in production behind HTTPS:
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://nagarsetu.pages.dev

# --- Storage & Database Configuration ---
# Optional: PostgreSQL connection string (defaults to SQLite progress.db if unset):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
SQLITE_PATH=progress.db
CHROMA_PATH=data/index/chroma
BM25_PATH=data/index/bm25.pkl
CHUNKS_PATH=data/processed/chunks.jsonl

# --- Frontend Settings ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
